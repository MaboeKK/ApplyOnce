# packages/api/.env.test.example
# Copy to .env.test and fill in. NEVER commit .env.test.
#
# This is what `npm test` loads (see src/config/index.ts) — deliberately
# separate from .env so the test suite's bulk-delete calls can never touch
# your dev database. The database name MUST contain "test" (enforced by
# src/__tests__/jest.setup.ts, which aborts the whole run otherwise).

NODE_ENV=test

# Same Postgres instance/port as dev, different database.
# Create it once with: psql -h localhost -p 3610 -U applyonce -c "CREATE DATABASE applyonce_test;"
DATABASE_URL="postgresql://applyonce:applyonce_dev_password@localhost:3610/applyonce_test"

REDIS_URL="redis://localhost:3611"

JWT_ACCESS_SECRET=test-jwt-access-secret-not-for-real-use
JWT_REFRESH_SECRET=test-jwt-refresh-secret-not-for-real-use
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

PAYGATE_ID=10011072130
PAYGATE_SECRET=test-secret
PAYGATE_SANDBOX=true

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads-test

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

EMAIL_MODE=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ApplyOnce <no-reply@applyonce.co.za>"
